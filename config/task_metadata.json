      ],
      "target_stack_level": 2,
      "pisa_attributes": [
        "mathematical_operation"
      ],
      "expected_answer": "3/5",
      "typical_errors": [
        {
          "error": "adds numerators AND denominators (2/5+1/5=3/10)",
          "construct": "part_whole",
          "stack_level": 1,
          "detection_patterns": [
            "3\\s*/\\s*10",
            "2\\s*/\\s*5\\+1\\s*/\\s*5",
            "adds? (both )?(the )?(tops? and bottoms?|numerators? and denominators?)",
            "\\d+\\s*plus\\s*\\d+.*\\d+\\s*plus\\s*\\d+"
          ]
        },
        {
          "error": "correct numerator, forgets to simplify when possible",
          "construct": "fraction_operations",
          "stack_level": 2
        }
      ],
      "task_family": "frac_add_common",
      "answer_strategy": "fraction_expression",
      "problem_type": "fraction_expression"
    },
    {
      "task_id": "frac_sub_unlike_01",
      "description": "Subtract fractions with unlike denominators: 5/6 - 1/3",
      "required_constructs": [
        "part_whole",
        "fraction_equivalence",
        "fraction_operations"
      ],
      "target_stack_level": 3,
      "pisa_attributes": [
        "mathematical_operation",
        "mathematical_abstraction"
      ],
      "expected_answer": "1/2",
      "typical_errors": [
        {
          "error": "subtracts numerators and denominators directly (5-1)/(6-3) = 4/3",
          "construct": "fraction_equivalence",
          "stack_level": 1,
          "detection_patterns": [
            "4\\s*/\\s*3",
            "subtract(?:s|ing)? (the )?(tops? and bottoms?|numerators? and denominators?)",
            "\\d+\\s*minus\\s*\\d+.*\\d+\\s*minus\\s*\\d+"
          ]
        },
        {
          "error": "finds LCD=6 but converts 1/3 to 2/6 incorrectly as 1/6",
          "construct": "fraction_equivalence",
          "stack_level": 2
        },
        {
          "error": "correct LCD=6, computes 5/6 - 2/6 = 3/6, does not simplify to 1/2",
          "construct": "fraction_operations",
          "stack_level": 2
        }
      ],
      "task_family": "frac_sub_unlike",
      "answer_strategy": "fraction_expression",
      "problem_type": "fraction_expression"
    },
    {
      "task_id": "frac_compare_01",
      "description": "Which is larger: 1/4 or 1/3? Explain your reasoning.",
      "required_constructs": [
        "part_whole"
      ],
      "target_stack_level": 2,
      "pisa_attributes": [
        "mathematical_abstraction",
        "logical_reasoning"
      ],
      "expected_answer": "1/3 is larger because the whole is split into fewer parts so each part is bigger",
      "typical_errors": [
        {
          "error": "says 1/4 is bigger because 4 > 3",
          "construct": "part_whole",
          "stack_level": 1,
          "detection_patterns": [
            "1\\s*/\\s*4 is (bigger|larger)",
            "4 is (bigger|larger) than 3",
            "bigger (denominator|bottom).{0,40}(bigger|larger)\\s+(fraction|piece|share)",
            "(denominator|bottom) is (bigger|larger).{0,40}(so|means).{0,20}(bigger|larger)"
          ]
        },
        {
          "error": "correct answer but no reasoning",
          "construct": "part_whole",
          "stack_level": 2
        }
      ],
      "task_family": "frac_compare",
      "answer_strategy": "frac_compare",
      "problem_type": "frac_compare"
    },
    {
      "task_id": "ratio_identify_01",
      "description": "There are 2 red marbles and 5 blue marbles. Write the ratio of red to blue.",
      "required_constructs": [
        "ratio_concept"
      ],
      "target_stack_level": 3,
      "pisa_attributes": [
        "mathematical_operation"
      ],
      "expected_answer": "2:5 or 2/5",
      "typical_errors": [
        {
          "error": "writes 5:2 (reverses order)",
          "construct": "ratio_concept",
          "stack_level": 1,
          "detection_patterns": [
            "5\\s*:\\s*2",
            "\\bblue\\s*(:|to)\\s*red\\b",
            "(other way around|reversed|wrong order|flip(?:ped)? (?:the )?order)"
          ]
        },
        {
          "error": "writes 2:7 (red to total instead of red to blue)",
          "construct": "ratio_concept",
          "stack_level": 2
        },
        {
          "error": "writes 2/5 but calls it a fraction, not a ratio (no conceptual distinction)",
          "construct": "ratio_concept",
          "stack_level": 2
        }
      ],
      "task_family": "ratio_identify",
      "answer_strategy": "ratio_identify",
      "problem_type": "ratio_identify"
    },
    {
      "task_id": "ratio_equivalence_01",
      "description": "Complete the ratio table: 2:3, 4:?, 6:9. What is the missing value?",
      "required_constructs": [
        "ratio_concept",
