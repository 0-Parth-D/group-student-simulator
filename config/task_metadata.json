{
  "tasks": [
    {
      "task_id": "frac_word_maria_pizza_01",
      "problem_type": "part_whole_word",
      "description": "Maria ate 3/8 of a pizza then gave away 1/4. How much is left?",
      "match_keywords": [
        "maria",
        "pizza",
        "ate",
        "gave away",
        "how much is left"
      ],
      "required_constructs": [
        "part_whole",
        "fraction_equivalence",
        "fraction_operations"
      ],
      "target_stack_level": 3,
      "pisa_attributes": [
        "mathematical_operation",
        "mathematical_modeling"
      ],
      "expected_answer": "3/8",
      "typical_errors": [
        {
          "error": "subtracts the fractions directly (3/8 - 1/4 = 1/8)",
          "construct": "fraction_equivalence",
          "stack_level": 1,
          "detection_patterns": [
            "1\\s*/\\s*8",
            "3\\s*/\\s*8\\s*\\-\\s*1\\s*/\\s*4",
            "3\\s*/\\s*8\\s*minus\\s*1\\s*/\\s*4",
            "subtract.*3\\s*/\\s*8.*1\\s*/\\s*4",
            "4\\s*/\\s*3",
            "subtract(?:s|ing)? (the )?(tops? and bottoms?|numerators? and denominators?)",
            "\\d+\\s*minus\\s*\\d+.*\\d+\\s*minus\\s*\\d+"
          ]
        },
        {
          "error": "gives away 1/4 of the remainder instead of 1/4 of the whole",
          "construct": "part_whole",
          "stack_level": 2
        },
        {
          "error": "correct setup but arithmetic slip converting 1/4 to eighths",
          "construct": "fraction_operations",
          "stack_level": 2
        }
      ],
      "task_family": "frac_word_part_whole",
      "answer_strategy": "part_whole_word"
    },
    {
      "task_id": "frac_add_common_01",
      "description": "Add fractions with common denominators: 2/5 + 1/5",
      "required_constructs": [
