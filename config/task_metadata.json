    {
      "task_id": "phone_plans_linear_01",
      "problem_type": "linear_compare_word",
      "description": "A phone company (Plan A) charges a $20 monthly fee plus $0.10 per text message. Another company (Plan B) charges no monthly fee but $0.30 per text message. When is each plan better? Can you represent each plan and compare them?",
      "match_keywords": [
        "phone",
        "plan a",
        "plan b",
        "text message",
        "monthly fee",
        "0.10",
        "0.30"
      ],
      "required_constructs": [
        "unit_rate",
        "additive_vs_multiplicative",
        "rate_comparison",
        "linear_relationship",
        "symbolic_modeling"
      ],
      "lpf_progress_indicators": [
        "M.PRF.1c comparing two rates and evaluating them for a given situation (e.g., best value)",
        "M.NO.2d contrasting situations as additive or multiplicative",
        "M.PRF.1b distinguishing linear from nonlinear relationships in graphical and tabular representations",
        "M.PRF.1d/1f/1g symbolic equations that summarise how a quantity changes"
      ],
      "target_stack_level": 3,
      "pisa_attributes": [
        "mathematical_modeling",
        "logical_reasoning",
        "mathematical_operation"
      ],
      "expected_answer": "100 texts",
      "facilitator_solution": "Plan A: 20+0.1x; Plan B: 0.3x. Equal at x=100 (both $30). Plan B cheaper for fewer than 100 texts; Plan A cheaper for more than 100.",
      "typical_errors": [
        {
          "error": "treats $0.10 per text as adding 10 cents once (flat amount) instead of a constant rate 0.1 × number of texts",
          "construct": "additive_vs_multiplicative",
          "stack_level": 1,
          "detection_patterns": [
            "\\b20\\s*\\+\\s*10\\s*x\\b",
            "(?<![.\\d])10\\s*x\\b",
            "20\\.10",
            "plus 10 cents",
            "add(?:s|ing)?\\s+10\\b",
            "just 20 dollars plus 10"
          ]
        },
        {
          "error": "writes 10x instead of 0.1x (confuses cents with dollars)",
          "construct": "unit_rate",
          "stack_level": 1,
          "detection_patterns": [
            "\\b20\\s*\\+\\s*10\\s*x\\b",
            "(?<![.\\d])10\\s*x\\b",
            "20\\s*\\+\\s*10"
          ]
        },
        {
          "error": "treats 0.10/0.30 as monthly amounts rather than per-text rates",
          "construct": "unit_rate",
          "stack_level": 1,
          "detection_patterns": [
            "for the month",
            "(0\\.10|0\\.30|ten cents|thirty cents).{0,30}(month|monthly)",
            "(month|monthly).{0,30}(0\\.10|0\\.30|ten cents)",
            "another 0\\.10 for the month"
          ]
        },
        {
          "error": "drops the $20 monthly fee and models Plan A as only 0.1x",
          "construct": "additive_vs_multiplicative",
          "stack_level": 1
        },
        {
          "error": "claims Plan A is always better because the per-text rate is lower",
          "construct": "rate_comparison",
          "stack_level": 1,
          "detection_patterns": [
            "always better",
            "ten cents is less",
            "cheaper (rate|per text).{0,40}always",
            "always.{0,40}(cheaper|better).{0,40}(per text|rate)"
          ]
        },
        {
          "error": "assumes doubling the number of texts doubles the Plan A bill",
          "construct": "linear_relationship",
          "stack_level": 2
        },
        {
          "error": "draws or describes both plans as lines through the origin, losing Plan A's monthly fee",
          "construct": "linear_relationship",
          "stack_level": 1,
          "detection_patterns": [
            "through the origin",
            "start(?:s|ing)? at (zero|0)\\b"
          ]
        },
        {
          "error": "swaps which plan has the monthly fee vs the higher per-text rate",
          "construct": "symbolic_modeling",
          "stack_level": 1,
          "detection_patterns": [
            "plan a is 0\\.3",
            "plan b is 20\\s*\\+\\s*0\\.1",
            "mixed them up",
            "swapped (the )?(plans|rates)"
          ]
        },
        {
          "error": "compares the plans at one or two text counts only and never finds the crossover",
          "construct": "rate_comparison",
          "stack_level": 2
        },
        {
          "error": "sets up equations but cannot interpret what 0.1 or 0.3 means in context (calls them coefficients only)",
          "construct": "symbolic_modeling",
          "stack_level": 2
        },
        {
          "error": "sets plans equal but solves incorrectly (e.g. crossover at 20 or 50 instead of 100)",
          "construct": "symbolic_modeling",
          "stack_level": 2
        },
        {
          "error": "adds a $20 fee to both plans even though only Plan A has a monthly fee",
          "construct": "additive_vs_multiplicative",
          "stack_level": 2
        }
      ],
      "task_family": "linear_compare",
      "answer_strategy": "linear_compare_word"
    }
  ],
