    {
      "task_id": "unit_rate_01",
      "description": "A car travels 150 miles in 3 hours. What is the unit rate (miles per hour)?",
      "required_constructs": [
        "ratio_concept",
        "ratio_equivalence",
        "unit_rate"
      ],
      "target_stack_level": 3,
      "pisa_attributes": [
        "mathematical_operation",
        "mathematical_modeling"
      ],
      "expected_answer": "50 miles per hour",
      "typical_errors": [
        {
          "error": "divides hours by miles: 3/150 (inverts the ratio)",
          "construct": "unit_rate",
          "stack_level": 1,
          "detection_patterns": [
            "3\\s*/\\s*150",
            "3\\s*divided by\\s*150",
            "0\\.02\\b",
            "hours?\\s*(divided by|/)\\s*miles"
          ]
        },
        {
          "error": "computes 150/3=50 but writes answer as '50' without unit label",
          "construct": "unit_rate",
          "stack_level": 2
        },
        {
          "error": "says 'the rate is 150:3' without simplifying to unit rate",
          "construct": "ratio_equivalence",
          "stack_level": 2
        }
      ],
      "task_family": "unit_rate",
      "answer_strategy": "unit_rate",
      "problem_type": "unit_rate"
    },
