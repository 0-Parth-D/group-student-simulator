          "detection_patterns": [
            "4\\s*:\\s*5",
            "add(?:ed|ing)?\\s+\\d+\\s+to each",
            "add(?:ed|ing)?\\s+\\d+\\s+to both",
            "I added \\d+"
          ]
        },
        {
          "error": "multiplies numerator correctly but forgets denominator: 4:3",
          "construct": "ratio_equivalence",
          "stack_level": 2
        },
        {
          "error": "correct answer 6 but cannot explain why",
          "construct": "ratio_equivalence",
          "stack_level": 2
        }
      ],
      "task_family": "ratio_equivalence",
      "answer_strategy": "ratio_equivalence",
      "problem_type": "ratio_equivalence"
