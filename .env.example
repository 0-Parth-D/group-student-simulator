TAMU_CHAT_API_KEY=sk-your-tamu-key-here
# TAMU_CHAT_BASE_URL=https://chat-api.tamu.ai/openai
OPENAI_MODEL=protected.gpt-5.4

# Judges/classifiers/taggers use OPENAI_MODEL; student replies use STUDENT_OPENAI_MODEL.
# STUDENT_OPENAI_MODEL=protected.Claude Sonnet 4.6
# LLM_JUDGE_TEMPERATURE=0.0
# LLM_STUDENT_TEMPERATURE applies to non-thinking student models only.
# Claude Sonnet 4.6 (thinking) uses temp=1.0 per API; persona control comes from
# prompt (Part B) + token cap + critic refine.
# LLM_STUDENT_TEMPERATURE=0.85
# THINKING_MIN_MAX_TOKENS=2000
# STUDENT_MAX_TOKENS_MATH=200
# STUDENT_MAX_TOKENS_SOCIAL=280
# STUDENT_THINKING_MIN_MAX_TOKENS must be > Claude thinking.budget_tokens (use 2000+
# when STUDENT_OPENAI_MODEL is a thinking Claude). Default 384 is for non-Claude.
# STUDENT_THINKING_MIN_MAX_TOKENS=2000
# STUDENT_LLM_SEED=42   # optional; omit for live variety
# Claude thinking forces temperature=1.0; persona control is prompt + token cap + critic.
# GROUP_MATH_PROMPT_CHAR_SOFT_CAP=6500  # prompt-diet soft cap (tests)

# Fast/cheap turn tagger (recommended). Falls back to OPENAI_MODEL if unset.
# TURN_CLASSIFIER_MODEL=protected.gpt-4o-mini
# TURN_CLASSIFY_MODE=semantic_llm   # semantic_llm | llm | heuristic
# TURN_CLASSIFY_SEMANTIC=true
# LLM_VAGUE_MIN_CONFIDENCE=0.70

# Group facilitation: who may speak after a teacher move (Track C).
# Default in code is hybrid (LLM + regex must_not veto). Override only if needed:
# GROUP_CONSTRAINT_PARSER=hybrid
# GROUP_CONSTRAINT_PARSER=llm
# GROUP_CONSTRAINT_PARSER=regex

# Game-style orchestrator loop (mirrors pst-training-game); default on
# GROUP_GAME_FLOW=true
# GROUP_GAME_FLOW_MAX_ROUNDS=8
# GROUP_GAME_FLOW_STUDENT_CAP=4

# Multi-round peer continuation (LangGraph) after discuss/open/critique
# Continues until no student volunteers, or hits the safety cap.
# GROUP_MULTI_ROUND=true
# GROUP_PEER_MAX_ROUNDS=8
# GROUP_PEER_NUDGE_ROUNDS=3
# GROUP_TRANSCRIPT_WINDOW=10
# GROUP_PRIVATE_HIST_MAX=12

# Track B: session-fixed receptivity + scaffold vs direct-answer gate (group only)
# GROUP_TRACK_B=true

# Student reply refinement: llm = critic (personality+LP+misc) then rewrite; off = skip
# REFINE_MODE=llm
# REFINE_MAX_REVISIONS=2
# REFINE_SELECTIVE=true
# REGISTER_LLM=true   # LLM kid-register judge after keyword gate (before selective skip)

# Per-turn prompt/target/draft logs in eval_log exports
# GENERATION_DEBUG=true
# GENERATION_DEBUG_HIST_MAX=12

# CORS for pst-training-game (comma-separated); unset = allow all origins
# CORS_ORIGINS=http://localhost:3001,https://your-app.vercel.app

# Learning progression stack (optional)
USE_QDRANT=true
# QDRANT_PATH=backend/qdrant_storage
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password
