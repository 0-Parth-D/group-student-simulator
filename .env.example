TAMU_CHAT_API_KEY=sk-your-tamu-key-here
# TAMU_CHAT_BASE_URL=https://chat-api.tamu.ai/openai
OPENAI_MODEL=protected.gpt-5.4

# Judges/classifiers/taggers use OPENAI_MODEL; student replies use STUDENT_OPENAI_MODEL.
STUDENT_OPENAI_MODEL=protected.Claude Sonnet 4.6
# LLM_JUDGE_TEMPERATURE=0.0
# LLM_STUDENT_TEMPERATURE=0.85
# THINKING_MIN_MAX_TOKENS=2000

# Multi-round peer continuation after discuss/open/critique
# GROUP_MULTI_ROUND=true
# GROUP_PEER_MAX_ROUNDS=8
# GROUP_PEER_NUDGE_ROUNDS=3
# GROUP_TRANSCRIPT_WINDOW=10
# GROUP_PRIVATE_HIST_MAX=12

# Session-fixed receptivity + scaffold vs direct-answer gate (group only)
# GROUP_TRACK_B=true

# Local misconception retrieval (falls back to metadata if unset / unavailable)
USE_QDRANT=true
# QDRANT_PATH=data/qdrant_storage

# Optional graph store. Leave unset to use the in-memory YAML knowledge graph.
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password
